class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int n=nums1.length;
        int m=nums2.length;
        int []merge=new int[m+n];
        int k=0;
        for(int i=0;i<n;i++){
            merge[i]=nums1[i];

        }
        for(int i=0;i<m;i++){
            merge[n+i]=nums2[i];
        }
        Arrays.sort(merge);
        int t=merge.length;
        if(t%2==1){
            return (double)merge[t/2];
        }
        else{
            int m1=merge[t/2-1];
            int m2=merge[t/2];
            return ((double) m1+(double)m2)/2.0;
        }
        
    }
}
