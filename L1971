import java.util.*;

class Solution {

    // Create adjacency list
    public ArrayList<ArrayList<Integer>> createAdjList(int n, int[][] edges) {

        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();

        // Create empty list for every node
        for (int i = 0; i < n; i++) {
            adj.add(new ArrayList<>());
        }

        // Add edges (Undirected Graph)
        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];

            adj.get(u).add(v);
            adj.get(v).add(u);
        }

        return adj;
    }

    // DFS function
    public boolean dfs(ArrayList<ArrayList<Integer>> adj,
                       boolean[] visited,
                       int s,
                       int d) {

        // Mark current node as visited
        visited[s] = true;

        // If destination is found
        if (s == d) {
            return true;
        }

        // Visit all neighbors
        for (int nbr : adj.get(s)) {

            if (!visited[nbr]) {

                // If path is found through this neighbor
                if (dfs(adj, visited, nbr, d)) {
                    return true;
                }
            }
        }

        // No path found
        return false;
    }

    // LeetCode function
    public boolean validPath(int n, int[][] edges,
                             int source, int destination) {

        // Create graph
        ArrayList<ArrayList<Integer>> adj = createAdjList(n, edges);

        // Visited array
        boolean[] visited = new boolean[n];

        // Start DFS from source
        return dfs(adj, visited, source, destination);
    }
}
