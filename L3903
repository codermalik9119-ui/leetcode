class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int n=nums.length;
        int [] suff=new int[n];
        int m=Integer.MAX_VALUE;
        for(int i=n-1;i>=0;i--){
            m=Math.min(m,nums[i]);
            suff[i]=m;
        }
        int mx=0;
        for(int i=0;i<n;i++){
            mx=Math.max(mx,nums[i]);
            int sc=mx-suff[i];
            if(sc<=k){
                return i;
            }
        }
            return -1;
        
        
    }
}
