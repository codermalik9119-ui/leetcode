class Solution {
    public int lengthOfLongestSubstring(String s) {
        int l=0;
        int m=0;
        HashSet<Character>ar= new HashSet<>();
        for(int i=0;i<s.length();i++){
            while(ar.contains(s.charAt(i))){
                ar.remove(s.charAt(l));
                l++;
            }
            ar.add(s.charAt(i));
            m=Math.max(m,i-l+1);
        }
        return m;
        
    }
}
